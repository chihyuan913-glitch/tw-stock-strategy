# ========================================================
# 台股量化選股戰情室 環境變數設定範本 (.env.example)
# ========================================================

# ========================================================
# 🚀 永久免費・無每月則數上限方案：Telegram Bot (強烈推薦！)
# ========================================================
# 痛點說明：LINE Messaging API 免費方案每月僅有 200 則 Push 訊息配額。
# 若搭配 Telegram Bot，即可享有「100% 永久免費、無訊息則數上限、即時秒級推播」。
#
# 【1 分鐘超簡易設定教學】：
# 1. 打開手機 Telegram App，搜尋官方機器人之父：@BotFather
# 2. 發送指令「/newbot」，依提示為機器人取名（例如：台股量化戰情），取得「HTTP API Token」
#    例如：7123456789:AAHxxxxxxxxx
# 3. 搜尋機器人：@userinfobot 並點擊「Start」，即可看到自己的數字「Id」
#    例如：123456789
# 4. 點開您剛建立的機器人聊天室，點擊「Start」發送任一訊息（完成開通）
# 5. 將取得的 Token 與 Id 填入下方即可！
# ========================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_or_group_id_here

# （選填）各策略獨立分流 Telegram 頻道/群組 (若留空則一律發送至上述 TELEGRAM_CHAT_ID)
# TELEGRAM_CHAT_ID_01=
# TELEGRAM_CHAT_ID_02=
# TELEGRAM_CHAT_ID_03=
# TELEGRAM_CHAT_ID_04=
# TELEGRAM_CHAT_ID_05=
# TELEGRAM_CHAT_ID_06=
# TELEGRAM_CHAT_ID_07=
# TELEGRAM_CHAT_ID_08=

# ========================================================
# 🎮 備援無限制方案：Discord Webhook (選填)
# ========================================================
# 於 Discord 伺服器頻道設定 -> 整合 -> Webhook 建立即可取得網址
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ========================================================
# LINE 推播設定檔 (每月 200 則配額)
# ========================================================
# 官方方案：LINE Messaging API (LINE Developers 免費 Bot)
# 1. 前往 https://developers.line.biz/ 登入
# 2. 建立 Provider 並建立 Messaging API Channel
# 3. 在 Messaging API 標籤頁下方點擊 Issue 取得 Channel access token
# 4. 在 Basic settings 標籤頁下方找到 Your user ID (以 U 開頭)
# 5. 將 Bot 加為好友或加入專屬群組
# ========================================================
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_ACCESS_TOKEN_BACKUP=your_backup_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# ========================================================
# 🎯 各策略獨立專屬 LINE 視窗 (群組 Group ID，以 C 開頭)
# 建立專屬群組並將 Bot 拉入，即可將各策略訊號分流至獨立聊天室！
# 若以下未填寫，系統將自動 Fallback 傳送至上方的 LINE_USER_ID 個人視窗。
# ========================================================
LINE_TARGET_STRATEGY_01=your_group_id_for_strategy_01_here  # 【01 布林超跌抄底群】
LINE_TARGET_STRATEGY_02=your_group_id_for_strategy_02_here  # 【02 法人起漲主升段群】
LINE_TARGET_STRATEGY_03=your_group_id_for_strategy_03_here  # 【03 股期做空避險群】
LINE_TARGET_STRATEGY_04=your_group_id_for_strategy_04_here  # 【04 可轉債定價伏擊群】
LINE_TARGET_STRATEGY_05=your_group_id_for_strategy_05_here  # 【05 個股期貨多方波段群】
LINE_TARGET_STRATEGY_06=your_group_id_for_strategy_06_here  # 【06 盤中爆量起漲動能群】
LINE_TARGET_STRATEGY_07=your_group_id_for_strategy_07_here  # 【07 高融資斷頭與浮額清洗群】
LINE_TARGET_STRATEGY_08=your_group_id_for_strategy_08_here  # 【08 集團作帳與母子聯動群】

# ========================================================
# 🌐 Cloudflare 具名通道 (固定永久外網網址)
# 支援本機憑證模式 (CLOUDFLARE_TUNNEL_NAME) 或 Token 模式 (CLOUDFLARE_TUNNEL_TOKEN)
# 若填寫以下項目，系統將自動啟動具名通道，重開機網址永遠不變！
# 若留空，系統將自動退回使用免費隨機通道 (trycloudflare.com)。
# ========================================================
CLOUDFLARE_TUNNEL_NAME=chihyuan-tunnel
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_DOMAIN=stock.chihyuan.date
