# ========================================================
# LINE 推播設定檔 (.env)
# ========================================================
# 官方方案：LINE Messaging API (LINE Developers 免費 Bot)
# 1. 前往 https://developers.line.biz/ 登入
# 2. 建立 Provider 並建立 Messaging API Channel
# 3. 在 Messaging API 標籤頁下方點擊 Issue 取得 Channel access token
# 4. 在 Basic settings 標籤頁下方找到 Your user ID (以 U 開頭)
# 5. 將 Bot 加為好友或加入專屬群組
# ========================================================

LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# ========================================================
# 🎯 方案 A：各策略獨立專屬 LINE 視窗 (群組 Group ID，以 C 開頭)
# 建立專屬群組並將 Bot 拉入，即可將各策略訊號分流至獨立聊天室！
# 若以下未填寫，系統將自動 Fallback 傳送至上方的 LINE_USER_ID 個人視窗。
# ========================================================
LINE_TARGET_STRATEGY_01=your_group_id_for_strategy_01_here  # 【01 布林超跌抄底群】
LINE_TARGET_STRATEGY_02=your_group_id_for_strategy_02_here  # 【02 法人起漲主升段群】
LINE_TARGET_STRATEGY_03=your_group_id_for_strategy_03_here  # 【03 股期做空避險群】

# (備用) 第三方 LINE Notify 代理服務：
# LINE_NOTIFY_TOKEN=your_notify_token_here
